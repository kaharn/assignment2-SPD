@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

interface Element {
  +accept(visitor: Visitor): void
}

class File {
  -name: String
  -sizeInBytes: long
  +File(name: String, sizeInBytes: long)
  +getName(): String
  +getSizeInBytes(): long
  +accept(visitor: Visitor): void
}

class Directory {
  -name: String
  -children: List<Element>
  +Directory(name: String, children: List<Element>)
  +getName(): String
  +getChildren(): List<Element>
  +accept(visitor: Visitor): void
}

interface Visitor {
  +visitFile(file: File): void
  +visitDirectory(directory: Directory): void
}

class SizeCalculatorVisitor {
  -totalSizeInBytes: long
  +calculate(element: Element): long
  +visitFile(file: File): void
  +visitDirectory(directory: Directory): void
}

class SearchVisitor {
  -extension: String
  -matches: List<File>
  +SearchVisitor(extension: String)
  +search(element: Element): List<File>
  +visitFile(file: File): void
  +visitDirectory(directory: Directory): void
}

File ..|> Element
Directory ..|> Element
SizeCalculatorVisitor ..|> Visitor
SearchVisitor ..|> Visitor
Element ..> Visitor : accepts
@enduml
